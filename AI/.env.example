# Copy to AI/.env and fill in your key
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Must match the backend's JWT_SECRET (backend default is secret123)
JWT_SECRET=secret123

# Express backend the assistant calls on behalf of the logged-in user
BACKEND_API_URL=http://127.0.0.1:5001/api

AI_PORT=8000
